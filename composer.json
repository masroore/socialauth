{
    "name": "masroore/socialauth",
    "description": "Social authentication through Laravel Socialite",
    "keywords": [
        "laravel",
        "socialite",
        "oauth",
        "social",
        "login",
        "social-auth"
    ],
    "homepage": "https://github.com/masroore/socialauth",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Masroor Ehsan",
            "email": "masroore@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/contracts": "^11.0",
        "illuminate/support": "^11.0",
        "intervention/image": "^3.8",
        "symfony/http-foundation": "^7.1",
        "symfony/psr-http-message-bridge": "^7.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.22",
        "laravel/pint": "^1.13",
        "nunomaduro/collision": "^8.4",
        "nunomaduro/larastan": "^2.9",
        "orchestra/testbench": "^9.5",
        "pestphp/pest": "^3.2",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-deprecation-rules": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Masroore\\SocialAuth\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Masroore\\SocialAuth\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Masroore\\SocialAuth\\SocialAuthServiceProvider"
            ],
            "aliases": {
                "Socialauth": "Masroore\\SocialAuth\\Facades\\SocialAuthFacade"
            }
        }
    }
}
